{
  // Statische Website: Cloudflare liefert den Ordner public/ aus.
  // Nur /art und /art/* laufen zuerst durch src/worker.js (Passwortschutz), alles andere kommt direkt aus public/.
  "name": "jakob-christensen-website",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/art", "/art/*"]
  }
}
